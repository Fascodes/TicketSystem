# =====================================================================
# Template for .env - copy to .env and fill in values.
# Format: KEY=value, no quotes (Spring parses .env as .properties).
# [SECRET] = to be moved to a secret manager.
# =====================================================================

# --- Database [SECRET] ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# --- Docker ---
DB_CONTAINER_NAME=ticket-system-db

# --- JWT [SECRET: key files] ---
# Prod (VM): keys outside the repo, e.g. /etc/ticket-system/keys/private.pem
#   chown <app-user> private.pem && chmod 600 private.pem   (public.pem may be 644)
# Directory with {kid}.private.pem (active key only) and {kid}.public.pem (active + retired keys)
# Rotation: add new pair, set JWT_KEY_ID to new kid, restart; remove old public.pem after access-ttl
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out keys/<kid>.private.pem
#   openssl pkey -in keys/<kid>.private.pem -pubout -out keys/<kid>.public.pem
JWT_KEYS_DIR=./keys
# Active signing key, e.g. key-2026-10
JWT_KEY_ID=
JWT_ISSUER=

# --- App ---
# Comma-separated, exact origins (scheme + host + port). Prod: only the real frontend domain over https.
APP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Optional, dev only
JPA_SHOW_SQL=true
